# Scan every 2023 (or other-year) Muon data file to identify which trigger
# branches are present per file.
# Submit examples:
#   condor_submit scan_2023_triggers-condor.jdl YEAR=2023
#   condor_submit scan_2023_triggers-condor.jdl YEAR=2022

universe                = vanilla
Executable              = shell
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = shell, scan_2023_trigger_availability.py, infiles
stream_output           = True
stream_error            = True
on_exit_remove          = (ExitBySignal == False) && (ExitCode == 0)
max_retries             = 2

# The CSV report is the only output; transfer it back to the per-year run dir.
transfer_output_files   = scan_$(YEAR)_trig_report.csv
transfer_output_remaps  = "scan_$(YEAR)_trig_report.csv=scan_$(YEAR)/scan_$(YEAR)_trig_report.csv"

request_memory          = 2 GB

Output                  = scan_$(YEAR)/$(Cluster)_$(Process).out
Error                   = scan_$(YEAR)/$(Cluster)_$(Process).err
Log                     = scan_$(YEAR)/$(Cluster)_$(Process).log

Arguments               = coffeateam/coffea-dask-almalinux8:2025.10.2-py3.10 python3 -u scan_2023_trigger_availability.py --year $(YEAR)
Queue 1
